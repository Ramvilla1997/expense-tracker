rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth.token.email.lower();
    }
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email() in get(/databases/$(database)/documents/households/family).data.members;
    }
    function incoming() {
      return request.resource.data;
    }
    function validMoney(d) {
      return d.amount is int && d.amount > 0 && d.amount <= 99999999999
        && d.get('currency', 'CAD') in ['CAD', 'INR'];
    }
    function shortText(value, max) {
      return value is string && value.size() <= max;
    }

    match /households/family {
      // The member list is managed in the Firebase console only.
      allow read: if isMember();
      allow write: if false;

      match /entries/{entryId} {
        function validEntry(d) {
          return d.keys().hasOnly(['type', 'amount', 'currency', 'category', 'note', 'scope', 'by', 'date', 'deleted', 'debtId', 'clientCreatedAt', 'createdAt', 'updatedAt'])
            && d.get('type', 'expense') in ['expense', 'income']
            && validMoney(d)
            && shortText(d.category, 30)
            && shortText(d.get('note', ''), 120)
            && d.scope in ['mine', 'shared']
            && d.by == email()
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.deleted is bool
            && (!('clientCreatedAt' in d) || d.clientCreatedAt is number)
            && (!('debtId' in d) || (d.debtId is string && d.debtId.size() <= 40));
        }
        allow read: if isMember();
        allow create: if isMember() && validEntry(incoming()) && incoming().deleted == false;
        allow update: if isMember() && resource.data.by == email() && validEntry(incoming());
        allow delete: if false; // soft delete only, so Undo always works
      }

      match /bills/{billId} {
        function validBill(d) {
          return d.keys().hasOnly(['name', 'amount', 'currency', 'dueDay', 'scope', 'by', 'paidMonths', 'startMonth', 'deleted', 'createdAt', 'updatedAt'])
            && shortText(d.name, 40) && d.name.size() > 0
            && validMoney(d)
            && d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31
            && d.scope in ['mine', 'shared']
            && d.paidMonths is list && d.paidMonths.size() <= 60
            && d.deleted is bool;
        }
        allow read: if isMember();
        allow create: if isMember() && validBill(incoming()) && incoming().by == email() && incoming().deleted == false;
        // The owner edits everything; the other person may only tick a shared bill as paid.
        allow update: if isMember() && validBill(incoming()) && incoming().by == resource.data.by
          && (resource.data.by == email()
            || (resource.data.scope == 'shared'
              && incoming().diff(resource.data).affectedKeys().hasOnly(['paidMonths', 'updatedAt'])));
        allow delete: if false;
      }

      match /debts/{debtId} {
        function validDebt(d) {
          return d.keys().hasOnly(['name', 'type', 'currency', 'balance', 'balanceDate', 'minimum', 'dueDay', 'apr', 'scope', 'by', 'deleted', 'createdAt', 'updatedAt'])
            && shortText(d.name, 40) && d.name.size() > 0
            && d.type in ['card', 'loan', 'person']
            && d.currency in ['CAD', 'INR']
            && d.balance is int && d.balance >= 0 && d.balance <= 99999999999
            && d.balanceDate is string && d.balanceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.minimum is int && d.minimum >= 0 && d.minimum <= 99999999999
            && d.dueDay is int && d.dueDay >= 0 && d.dueDay <= 31
            && (d.apr == null || (d.apr is number && d.apr >= 0 && d.apr <= 100))
            && d.scope in ['mine', 'shared']
            && d.deleted is bool;
        }
        allow read: if isMember();
        allow create: if isMember() && validDebt(incoming()) && incoming().by == email() && incoming().deleted == false;
        // Only the owner edits a debt; payments are entries, so the other person never needs to.
        allow update: if isMember() && resource.data.by == email() && validDebt(incoming()) && incoming().by == resource.data.by;
        allow delete: if false;
      }

      // This phone's push subscription, keyed by the person's own email. Only the daily job reads all of them.
      match /push/{subEmail} {
        function validPush(d) {
          return d.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'updatedAt'])
            && d.endpoint is string && d.endpoint.size() <= 1000
            && d.endpoint.matches('^https://.*')
            && d.p256dh is string && d.p256dh.size() <= 200
            && d.auth is string && d.auth.size() <= 100;
        }
        allow read, delete: if isMember() && subEmail == email();
        allow create, update: if isMember() && subEmail == email() && validPush(incoming());
      }

      match /profiles/{profileEmail} {
        function validProfile(d) {
          return d.keys().hasOnly(['name', 'homeCurrency', 'displayCurrency', 'monthlyBudget', 'payFrequency', 'payAnchor', 'updatedAt'])
            && (!('name' in d) || (shortText(d.name, 40) && d.name.size() > 0))
            && (!('homeCurrency' in d) || d.homeCurrency in ['CAD', 'INR'])
            && (!('displayCurrency' in d) || d.displayCurrency in ['CAD', 'INR'])
            && (!('monthlyBudget' in d) || (d.monthlyBudget is int && d.monthlyBudget >= 0 && d.monthlyBudget <= 99999999999))
            && (!('payFrequency' in d) || d.payFrequency == null || d.payFrequency in ['biweekly', 'monthly'])
            && (!('payAnchor' in d) || d.payAnchor == null || (d.payAnchor is string && d.payAnchor.size() == 10));
        }
        allow read: if isMember();
        allow create, update: if isMember() && profileEmail == email() && validProfile(incoming());
        allow delete: if false;
      }
    }
  }
}
